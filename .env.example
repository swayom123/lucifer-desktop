# Optional AI provider keys; voice recognition stays local.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
WAKE_WORD=lucifer
STT_MODEL=base.en
# Limits Whisper's native worker threads; one shared model serves both voice paths.
STT_CPU_THREADS=2
TTS_PROVIDER=livekit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TTS_MODEL=cartesia/sonic-3
# Cartesia Brandon voice UUID.
LIVEKIT_TTS_VOICE=5cad89c9-d88a-4832-89fb-55f2f16d13d3
NOTION_API_KEY=
NOTION_CONNECTION_NAME=Lucifer
# Optional explicit targets; when empty, Lucifer searches shared pages by common names.
NOTION_CALENDAR_DATA_SOURCE_ID=
NOTION_NOTES_PAGE_ID=
# Empty uses the platform's private user data directory.
LUCIFER_DATA_DIR=
